# Copy to .env.local (git-ignored) and adjust. Expo inlines EXPO_PUBLIC_* values
# into the bundle and Metro caches them, so restart with `npx expo start --clear`
# after changing them. See docs/backend-integration.md.

# Base URL of the Go backend, without a trailing slash.
# Leave empty to run the app on built-in demo data (no backend needed).
#   Web / iOS simulator:  http://localhost:8080
#   Android emulator:     http://10.0.2.2:8080
#   Physical phone:       http://<your computer's LAN IP>:8080
EXPO_PUBLIC_API_URL=
